# Copy to .env (setup.sh does this). .env is gitignored.
DATABASE_URL=postgresql://kb:kb@127.0.0.1:54329/kb

# Embeddings run locally through Ollama.
OLLAMA_URL=http://127.0.0.1:11434
EMBED_MODEL=qwen3-embedding:8b
EMBED_DIM=4096
# Qwen3 embedding models expect this in front of search queries (not documents).
EMBED_QUERY_PREFIX=Instruct: Given a web search query, retrieve relevant passages that answer the query\nQuery:

# Lighter alternative with the same query prefix (then ./kb reset && ./kb index):
#   EMBED_MODEL=qwen3-embedding:0.6b
#   EMBED_DIM=1024

# ollama = real embeddings. hash = offline bag-of-words stand-in, only for
# smoke-testing the pipeline without Ollama; its rankings mean nothing.
KB_EMBED=ollama

# Sections left out of the index, by heading text. Remove "code samples" to
# index the API pages' client code and CLI samples too (about 3x the API
# embedding time). Changing this re-chunks everything on the next ./kb index.
KB_SKIP_SECTIONS=agent instructions,code samples
